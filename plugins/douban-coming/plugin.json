{
  "api_version": 1,
  "id": "douban-coming",
  "name": "豆瓣将映",
  "version": "1.0.7",
  "description": "监控豆瓣即将开播电视剧，按想看人数筛选，提前创建订阅并发送开播提醒。",
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "scheduled_actions": [
    {
      "action": "refresh",
      "label": "立即刷新",
      "manual": true,
      "cron_setting": "cron",
      "timeout_seconds": 180
    }
  ],
  "requested_scopes": [
    "catalog:read",
    "subscriptions:read",
    "subscriptions:write",
    "notifications:send"
  ],
  "auto_grant_scopes": true,
  "data_view": {
    "title": "将映处理记录",
    "file": "data/history.json",
    "item_label": "剧集",
    "summary": [
      {"key": "runs", "label": "运行次数"},
      {"key": "subscribed", "label": "已创建订阅"},
      {"key": "notifications", "label": "已发提醒"}
    ],
    "fields": [
      {"key": "title", "label": "剧名", "primary": true},
      {"key": "wish_count", "label": "想看人数"},
      {"key": "air_date", "label": "开播日期"},
      {"key": "subscription", "label": "订阅"},
      {"key": "reminder", "label": "提醒"},
      {"key": "processed_at", "label": "处理时间"}
    ]
  },
  "settings_schema": {
    "sections": [
      {
        "title": "数据源与周期",
        "fields": [
          {"key": "$enabled", "type": "switch", "label": "启用插件", "default": false},
          {"key": "cron", "type": "text", "label": "执行周期", "default": "0 8 * * *", "help": "5 位 cron 表达式，按 Mediary 所在时区执行。"},
          {"key": "rsshub", "type": "text", "label": "RSSHub 地址", "default": "https://rsshub.ddsrem.com", "placeholder": "https://rsshub.example.com"},
          {"key": "sort_by", "type": "select", "label": "排序方式", "default": "hot", "options": [{"label": "热度", "value": "hot"}, {"label": "时间", "value": "time"}]},
          {"key": "count", "type": "number", "label": "请求数量", "default": 10, "min": 1, "max": 100}
        ]
      },
      {
        "title": "订阅与提醒",
        "fields": [
          {"key": "wish_count_threshold", "type": "number", "label": "想看人数阈值", "default": 5000, "min": 0},
          {"key": "advance_days", "type": "number", "label": "提前订阅天数", "default": 7, "min": 0, "max": 365},
          {"key": "notify_before_air", "type": "switch", "label": "开播前提醒", "default": true},
          {"key": "notify_hours", "type": "number", "label": "提醒提前小时数", "default": 24, "min": 1, "max": 720},
          {"key": "clear", "type": "switch", "label": "下次运行时清理历史", "default": false, "help": "仅清除插件自己的处理与提醒记录，不会删除 Mediary 订阅。"}
        ]
      }
    ]
  }
}
