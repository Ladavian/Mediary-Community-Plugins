{
  "api_version": 1,
  "id": "dockercopilot-helper",
  "name": "DC 助手",
  "version": "1.0.9",
  "description": "连接 Docker Copilot，检查容器更新、按选项自动更新、清理未使用的无标签镜像并备份容器配置，并发送系统通知。",
  "requested_scopes": ["notifications:send"],
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "interactive_view": {
    "title": "容器选择",
    "eyebrow": "Docker Copilot",
    "action": "dashboard",
    "trigger": {
      "label": "选择容器",
      "icon": "server"
    },
    "submit": {
      "label": "保存选择",
      "pending_label": "保存中",
      "icon": "check"
    },
    "auto_run": true,
    "layout": "list",
    "form_collapsible": false,
    "fields": [
      {
        "key": "update_containers",
        "type": "multiselect",
        "label": "检查更新的容器",
        "help": "留空时检查所有容器。"
      },
      {
        "key": "auto_update_containers",
        "type": "multiselect",
        "label": "自动更新容器",
        "help": "仅会更新这里勾选、且 Docker Copilot 标记为可更新的容器。"
      }
    ],
    "empty": {
      "text": "尚未发现容器，请检查 Docker Copilot 地址和 Secret Key。",
      "icon": "server"
    },
    "error_message": "读取 Docker Copilot 容器失败，请检查连接配置。"
  },
  "scheduled_actions": [
    {
      "action": "check_updates",
      "label": "检查容器更新",
      "manual": true,
      "cron_setting": "update_check_cron",
      "timeout_seconds": 60
    },
    {
      "action": "auto_update",
      "label": "自动更新容器",
      "manual": true,
      "cron_setting": "auto_update_cron",
      "timeout_seconds": 900
    },
    {
      "action": "backup",
      "label": "备份容器配置",
      "manual": true,
      "cron_setting": "backup_cron",
      "timeout_seconds": 60
    }
  ],
  "secret_fields": ["secret_key"],
  "settings_schema": {
    "sections": [
      {
        "title": "Docker Copilot 连接",
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用插件",
            "default": false
          },
          {
            "key": "host",
            "type": "text",
            "label": "Docker Copilot 地址",
            "placeholder": "http://192.168.1.10:12712",
            "span": 2
          },
          {
            "key": "secret_key",
            "type": "text",
            "label": "Docker Copilot Secret Key",
            "placeholder": "Docker Copilot 的密钥",
            "span": 2
          }
        ]
      },
      {
        "title": "更新检查与自动更新",
        "fields": [
          {
            "key": "update_check_cron",
            "type": "text",
            "label": "更新检查周期",
            "default": "0 */6 * * *",
            "placeholder": "0 */6 * * *"
          },
          {
            "key": "auto_update_cron",
            "type": "text",
            "label": "自动更新周期",
            "default": "0 4 * * *",
            "placeholder": "0 4 * * *"
          },
          {
            "key": "clean_unused_images",
            "type": "switch",
            "label": "自动更新前清理无标签且未使用的镜像",
            "default": false,
            "span": 2
          }
        ]
      },
      {
        "title": "备份与进度",
        "fields": [
          {
            "key": "backup_cron",
            "type": "text",
            "label": "备份周期",
            "default": "0 3 * * *",
            "placeholder": "0 3 * * *"
          },
          {
            "key": "track_progress",
            "type": "switch",
            "label": "跟踪更新进度",
            "default": true
          },
          {
            "key": "progress_interval_seconds",
            "type": "number",
            "label": "进度轮询间隔（秒）",
            "default": 10,
            "min": 1,
            "max": 300
          },
          {
            "key": "progress_attempts",
            "type": "number",
            "label": "最大轮询次数",
            "default": 6,
            "min": 1,
            "max": 100
          }
        ]
      },
      {
        "title": "通知",
        "fields": [
          {
            "key": "send_notifications",
            "type": "switch",
            "label": "发送系统通知",
            "help": "自动更新、备份或操作失败时发送通知。",
            "default": true
          },
          {
            "key": "notify_when_no_updates",
            "type": "switch",
            "label": "无更新时也通知",
            "help": "关闭后，仅在检查到可更新容器时通知。",
            "default": false
          }
        ]
      }
    ]
  },
  "data_view": {
    "title": "最近一次执行",
    "file": "data/last-run.json",
    "summary": [
      {"key": "action", "label": "动作"},
      {"key": "ok", "label": "成功"}
    ],
    "fields": [
      {"key": "action", "label": "动作", "primary": true},
      {"key": "notice", "label": "结果"},
      {"key": "completed_at", "label": "完成时间"}
    ]
  }
}
